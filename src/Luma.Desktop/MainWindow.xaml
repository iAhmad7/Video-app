<Window x:Class="Luma.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF" Title="Luma · Video Toolkit" Width="1260" Height="840" MinWidth="980" MinHeight="700" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,22">
    <StackPanel DockPanel.Dock="Top" Margin="10,0,0,24"><TextBlock FontSize="30" FontWeight="Bold" Text="luma" Foreground="{DynamicResource Accent}"/><TextBlock Text="VIDEO TOOLKIT" FontSize="10" Foreground="{DynamicResource Muted}" Margin="1,3,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,18,4,0"><TextBlock Text="MADE TO STAY LIGHT" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ToolBadge" Text="Checking FFmpeg…" FontSize="11" Margin="0,8,0,0"/><TextBlock Text="Local files. Original preserved." FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel>
    <StackPanel x:Name="Navigation">
     <TextBlock Text="WORKSPACE" FontSize="10" Margin="12,0,0,10" Foreground="{DynamicResource Muted}"/>
     <Button Style="{StaticResource Nav}" Content="↗   Converter" Tag="Convert" Click="Navigate"/>
     <Button Style="{StaticResource Nav}" Content="▥   Compressor" Tag="Compress" Click="Navigate"/>
     <Button Style="{StaticResource Nav}" Content="⇄   Remuxer" Tag="Remux" Click="Navigate"/>
     <Button Style="{StaticResource Nav}" Content="✂   Cutter" Tag="Cut" Click="Navigate"/>
     <Button Style="{StaticResource Nav}" Content="◇   Video repair" Tag="Repair" Click="Navigate"/>
     <Button Style="{StaticResource Nav}" Content="ⓘ   Media information" Tag="Info" Click="Navigate"/>
     <Button Style="{StaticResource Nav}" Content="⊞   Audio &amp; image" Tag="Utilities" Click="Navigate"/>
     <Border Height="1" Background="{DynamicResource Line}" Margin="10,16"/>
     <Button Style="{StaticResource Nav}" Content="≡   Processing queue" Tag="Queue" Click="Navigate"/>
     <Button Style="{StaticResource Nav}" Content="⚙   Settings" Tag="Settings" Click="Navigate"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,22,26,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Video converter" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="A new format. The same story." Foreground="{DynamicResource Muted}" Margin="0,5,12,0"/></StackPanel><Button x:Name="ImportButton" Grid.Column="1" Content="＋  Add videos" Style="{StaticResource Primary}" Click="Import_Click" VerticalAlignment="Center"/></Grid>
   <Grid Grid.Row="1" x:Name="WorkspacePage">
    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" Padding="10">
     <DockPanel>
      <StackPanel DockPanel.Dock="Top" Margin="8,7,8,12"><TextBlock Text="YOUR MEDIA" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="LibraryCount" Text="0 files" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom"><Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,4"><StackPanel><TextBlock Text="↓  Drop videos here" HorizontalAlignment="Center" FontWeight="SemiBold"/><TextBlock Text="MP4 · MKV · TS · and more" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border><Button Content="Remove selected from list" FontSize="11" Click="RemoveMedia_Click" Margin="0,5,0,0"/></StackPanel>
      <ListBox x:Name="MediaList" SelectionMode="Extended" SelectionChanged="Media_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel><Image Source="{Binding Thumbnail}" Height="64" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,7"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding SmallInfo}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </DockPanel>
    </Border>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,6,0">
       <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
        <StackPanel><Grid Height="200" Background="#080C12"><Image x:Name="PreviewImage" Stretch="Uniform"/><TextBlock x:Name="PreviewPlaceholder" Text="Select a video to see its preview" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A5B2C7"/><vlc:VideoView x:Name="VideoView" Visibility="Collapsed"/></Grid>
         <Grid Margin="12,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="PlayButton" Content="▶" Click="Play_Click" Padding="10,4" ToolTip="Play or pause"/><Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Margin="12,0" VerticalAlignment="Center" PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/><TextBlock x:Name="PlaybackTime" Grid.Column="2" Text="00:00 / 00:00" FontSize="11" VerticalAlignment="Center"/></Grid>
         <Grid Margin="14,0,14,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectedSummary" Text="Thumbnails are generated only when you select a file." FontSize="11" Foreground="{DynamicResource Muted}"/><Button Grid.Column="1" Content="Open externally ↗" Padding="8,4" FontSize="11" Click="External_Click" Margin="8,0,0,0"/></Grid>
        </StackPanel>
       </Border>
       <Border x:Name="OperationCard" Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
         <TextBlock x:Name="OperationHeading" Text="Output settings" FontSize="17" FontWeight="SemiBold"/>
         <StackPanel x:Name="UtilitySection" Visibility="Collapsed"><TextBlock Style="{StaticResource Label}" Text="Utility"/><ComboBox x:Name="UtilityBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="Extract audio"/><ComboBoxItem Content="Export PNG frame"/><ComboBoxItem Content="Transform / resize"/></ComboBox><TextBlock x:Name="AudioFormatLabel" Style="{StaticResource Label}" Text="Audio format"/><ComboBox x:Name="AudioFormatBox"><ComboBoxItem Content="mp3"/><ComboBoxItem Content="m4a"/><ComboBoxItem Content="wav"/><ComboBoxItem Content="flac"/></ComboBox></StackPanel>
         <Grid x:Name="EncodingSection"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Label}" Text="Container"/><ComboBox x:Name="ContainerBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="mp4"/><ComboBoxItem Content="mkv"/><ComboBoxItem Content="mov"/><ComboBoxItem Content="avi"/><ComboBoxItem Content="webm"/><ComboBoxItem Content="flv"/><ComboBoxItem Content="ts"/></ComboBox></StackPanel><StackPanel x:Name="CodecSection" Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Video codec"/><ComboBox x:Name="CodecBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="H.264" Tag="h264"/><ComboBoxItem Content="H.265 / HEVC" Tag="hevc"/><ComboBoxItem Content="VP9" Tag="vp9"/><ComboBoxItem Content="MPEG-4" Tag="mpeg4"/></ComboBox></StackPanel></Grid>
         <StackPanel x:Name="CompressionSection" Visibility="Collapsed"><TextBlock Style="{StaticResource Label}" Text="Compression method"/><ComboBox x:Name="CompressionBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="Quality-based"/><ComboBoxItem Content="Percentage reduction"/><ComboBoxItem Content="Target file size"/></ComboBox><StackPanel x:Name="ReductionSection" Visibility="Collapsed"><TextBlock x:Name="ReductionLabel" Text="Reduce file size by 50%" Margin="0,12,0,0"/><Slider x:Name="ReductionSlider" Minimum="10" Maximum="90" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,10,0,0" ValueChanged="Reduction_Changed"/></StackPanel><Grid x:Name="TargetSection" Visibility="Collapsed" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBox x:Name="TargetSizeBox" Text="100" TextChanged="TextOption_Changed"/><ComboBox x:Name="TargetUnitBox" Grid.Column="2" SelectionChanged="Options_Changed"><ComboBoxItem Content="MiB"/><ComboBoxItem Content="GiB"/></ComboBox></Grid><TextBlock x:Name="TargetEstimate" Foreground="{DynamicResource Accent}" Margin="0,10,0,0"/></StackPanel>
         <Grid x:Name="QualitySection"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Label}" Text="Preset"/><ComboBox x:Name="PresetBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="Fast"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="High Quality"/><ComboBoxItem Content="Small File"/><ComboBoxItem Content="Custom"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Resolution (height)"/><ComboBox x:Name="ResolutionBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="Original" Tag="0"/><ComboBoxItem Content="360p" Tag="360"/><ComboBoxItem Content="480p" Tag="480"/><ComboBoxItem Content="720p" Tag="720"/><ComboBoxItem Content="1080p" Tag="1080"/></ComboBox></StackPanel></Grid>
         <CheckBox x:Name="PreferCopyBox" Content="Copy streams when codec and image settings allow" IsChecked="True" Checked="Options_Changed" Unchecked="Options_Changed"/>
         <StackPanel x:Name="CutSection" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Label}" Text="Start · hh:mm:ss.fff or seconds"/><TextBox x:Name="StartBox" Text="00:00:00.000" TextChanged="TextOption_Changed"/><Button Content="Use playhead as start" Click="MarkStart_Click" Margin="0,6,0,0" FontSize="11"/></StackPanel><StackPanel x:Name="EndSection" Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="End · hh:mm:ss.fff or seconds"/><TextBox x:Name="EndBox" Text="00:00:10.000" TextChanged="TextOption_Changed"/><Button Content="Use playhead as end" Click="MarkEnd_Click" Margin="0,6,0,0" FontSize="11"/></StackPanel></Grid><CheckBox x:Name="PreciseBox" Content="Precise cut · re-encode for accurate boundaries" Checked="Options_Changed" Unchecked="Options_Changed"/><TextBlock x:Name="CutHelp" Text="Fast lossless cuts follow nearby keyframes. Precise cuts take longer." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel>
         <StackPanel x:Name="RepairSection" Visibility="Collapsed"><TextBlock Style="{StaticResource Label}" Text="Repair approach"/><ComboBox x:Name="RepairBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="Fix seeking"/><ComboBoxItem Content="Rebuild container"/><ComboBoxItem Content="Timestamp repair"/></ComboBox><TextBlock Text="Writes a new container; can recover remuxable indexes and timestamps. Missing or corrupt video data cannot always be repaired. Fix seeking and Timestamp repair generate missing PTS and shift negative timestamps; no guessed frame rate is applied." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0"/><WrapPanel Margin="0,12,0,0"><Button Content="Quick validation" Click="QuickValidate_Click" Margin="0,0,8,6"/><Button Content="Deep decode validation" Click="DeepValidate_Click" Margin="0,0,8,6"/><Button x:Name="CancelValidationButton" Content="Cancel validation" Click="CancelValidation_Click" IsEnabled="False" Margin="0,0,0,6"/></WrapPanel><CheckBox x:Name="DeepAfterBox" Content="Deep-validate repaired output (reads the entire file)"/><TextBox x:Name="ValidationReport" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/></StackPanel>
         <StackPanel x:Name="TransformSection" Visibility="Collapsed"><TextBlock Style="{StaticResource Label}" Text="Image transform"/><ComboBox x:Name="TransformBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="None"/><ComboBoxItem Content="Rotate 90°"/><ComboBoxItem Content="Rotate 180°"/><ComboBoxItem Content="Rotate 270°"/><ComboBoxItem Content="Flip horizontal"/><ComboBoxItem Content="Flip vertical"/></ComboBox><TextBlock Style="{StaticResource Label}" Text="Optional crop · width:height:x:y (before rotation)"/><TextBox x:Name="CropBox" TextChanged="TextOption_Changed"/></StackPanel>
         <Expander x:Name="AdvancedSection" Header="Advanced · encoding &amp; tracks" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"><StackPanel Margin="0,6,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Label}" Text="FPS · 0 keeps source timing"/><TextBox x:Name="FpsBox" Text="0" TextChanged="TextOption_Changed"/><TextBlock Style="{StaticResource Label}" Text="Custom quality · CRF 0–51"/><TextBox x:Name="CrfBox" Text="23" TextChanged="TextOption_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Video bitrate · kb/s (0 = quality)"/><TextBox x:Name="BitrateBox" Text="0" TextChanged="TextOption_Changed"/><TextBlock Style="{StaticResource Label}" Text="Custom CPU preset"/><ComboBox x:Name="SpeedBox" SelectionChanged="Options_Changed"><ComboBoxItem Content="ultrafast"/><ComboBoxItem Content="veryfast"/><ComboBoxItem Content="fast"/><ComboBoxItem Content="medium"/><ComboBoxItem Content="slow"/></ComboBox></StackPanel></Grid><CheckBox x:Name="RemoveAudioBox" Content="Remove all audio" Checked="Options_Changed" Unchecked="Options_Changed"/><TextBlock Style="{StaticResource Label}" Text="Audio global stream IDs · blank = all, example 1,2"/><TextBox x:Name="AudioTracksBox" TextChanged="TextOption_Changed"/><CheckBox x:Name="RemoveSubsBox" Content="Remove all subtitle tracks" Checked="Options_Changed" Unchecked="Options_Changed"/><TextBlock Style="{StaticResource Label}" Text="Subtitle global stream IDs · blank = all"/><TextBox x:Name="SubtitleTracksBox" TextChanged="TextOption_Changed"/><TextBlock Text="Data streams, attachments and cover art are not copied. Use Media information to inspect stream IDs." FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel></Expander>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Margin="0,12,0,6" Padding="14" BorderBrush="#386756"><StackPanel><TextBlock Text="PROCESSING NOTE" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="PlanText" Text="Select a file to check output compatibility." FontSize="12" Margin="0,7,0,0"/><TextBlock x:Name="PlanWarning" Foreground="{DynamicResource Warning}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
     <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Outputs go beside the source by default.&#10;Original files are always kept." Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="EnqueueButton" Style="{StaticResource Primary}" Content="Add selected to queue  →" Click="Enqueue_Click"/></Grid>
    </Grid>
   </Grid>
   <Grid Grid.Row="1" x:Name="InfoPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,14"><Button Content="Copy information" Click="CopyInfo_Click" Margin="0,0,10,0"/><Button Content="Export TXT / JSON" Click="ExportInfo_Click" Margin="0,0,10,0"/><Button Content="Compare with completed output" Click="Compare_Click"/></WrapPanel><TextBox Grid.Row="1" x:Name="InfoText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="20"/></Grid>
   <Grid Grid.Row="1" x:Name="QueuePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,15"><Button Content="Cancel selected" Click="CancelJob_Click" Margin="0,0,10,0"/><Button Content="Cancel all" Click="CancelAll_Click" Margin="0,0,10,0"/><Button Content="Open output folder" Click="OpenOutput_Click" Margin="0,0,10,0"/><Button Content="Clear finished" Click="ClearJobs_Click"/></WrapPanel><ListBox Grid.Row="1" x:Name="QueueList" SelectionChanged="Job_Changed"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,6"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{DynamicResource Accent}"/></Grid><TextBlock Text="{Binding Action}" Foreground="{DynamicResource Muted}" Margin="0,5,0,10"/><ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"/><TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" MaxHeight="45"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Grid.Row="2" x:Name="JobDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Grid>
   <ScrollViewer Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="850" HorizontalAlignment="Stretch" Margin="0,0,10,0">
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="General &amp; appearance" FontSize="18" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Label}" Text="Default output folder · blank uses each source folder"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseOutput_Click" Margin="8,0,0,0"/><TextBox x:Name="OutputFolderBox"/></DockPanel><TextBlock Style="{StaticResource Label}" Text="Filename suffix · blank uses the operation name"/><TextBox x:Name="SuffixBox"/><CheckBox x:Name="AutoOpenBox" Content="Open output folder after completion"/><CheckBox x:Name="ConfirmBox" Content="Confirm closing while jobs are active"/><CheckBox x:Name="RestoreBox" Content="Restore window size"/><CheckBox x:Name="RememberBox" Content="Remember processing preferences"/><CheckBox x:Name="LightBox" Content="Light appearance"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Performance" FontSize="18" FontWeight="SemiBold"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource Label}" Text="Encoding device"/><ComboBox x:Name="AccelerationBox"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="GPU"/><ComboBoxItem Content="CPU"/></ComboBox><TextBlock Style="{StaticResource Label}" Text="CPU threads · 1 to 4"/><TextBox x:Name="ThreadsBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Label}" Text="Concurrent jobs · 1 recommended, max 2"/><TextBox x:Name="ConcurrencyBox"/><TextBlock Style="{StaticResource Label}" Text="Thumbnail cache limit · MiB (8–512)"/><TextBox x:Name="CacheLimitBox"/></StackPanel></Grid><CheckBox x:Name="LowPriorityBox" Content="Run media jobs below normal process priority"/><CheckBox x:Name="DetailedBox" Content="Default to deep validation when validating"/><TextBlock Text="H.264 Quick Sync is used only after a real encoding test. Size-targeted jobs use CPU two-pass encoding. H.265 and VP9 use CPU. One job and two threads are recommended for your PC." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="FFmpeg &amp; acceleration" FontSize="18" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Label}" Text="Existing ffmpeg.exe · blank auto-detects PATH"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Tag="ffmpeg" Click="BrowseTool_Click" Margin="8,0,0,0"/><TextBox x:Name="FfmpegBox"/></DockPanel><TextBlock Style="{StaticResource Label}" Text="Existing ffprobe.exe · blank checks beside FFmpeg, then PATH"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Tag="ffprobe" Click="BrowseTool_Click" Margin="8,0,0,0"/><TextBox x:Name="FfprobeBox"/></DockPanel><WrapPanel Margin="0,14,0,0"><Button Content="Verify paths &amp; capabilities" Click="VerifyTools_Click" Margin="0,0,10,6"/><Button Content="Test Intel Quick Sync" Click="TestGpu_Click" Margin="0,0,10,6"/><Button Content="Show available encoders" Click="ShowEncoders_Click" Margin="0,0,0,6"/></WrapPanel><TextBox x:Name="ToolReport" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Storage &amp; cleanup" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StorageText" Foreground="{DynamicResource Muted}" Margin="0,10,0,10"/><WrapPanel><Button Content="Clear thumbnails" Click="ClearCache_Click" Margin="0,0,8,8"/><Button Content="Open logs" Click="OpenLogs_Click" Margin="0,0,8,8"/><Button Content="Clear logs older than 7 days" Click="CleanLogs_Click" Margin="0,0,8,8"/><Button Content="Export settings" Click="ExportSettings_Click" Margin="0,0,8,8"/><Button Content="Import settings" Click="ImportSettings_Click" Margin="0,0,8,8"/><Button Content="Reset settings" Click="ResetSettings_Click" Margin="0,0,8,8"/></WrapPanel></StackPanel></Border>
    <Button Style="{StaticResource Primary}" Content="Save settings" Click="SaveSettings_Click" HorizontalAlignment="Right" Margin="0,18,0,10" Padding="24,10"/>
   </StackPanel></ScrollViewer>
   <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,14,0,0" MaxHeight="34"/>
  </Grid>
 </Grid>
</Window>
